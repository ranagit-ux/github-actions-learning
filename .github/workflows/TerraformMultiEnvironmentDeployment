
name: Terraform Multi-Environment Deployment

on:
  push:
    branches:
      - develop
      - staging
      - main

permissions:
  contents: read
  id-token: write

# Prevent simultaneous deployments to the same environment
concurrency:
  group: terraform-${{ github.ref_name }}
  cancel-in-progress: false

jobs:
  deploy:
    name: Terraform Deploy
    runs-on: ubuntu-latest

    # Map Git branches to GitHub Environments
    environment: ${{ github.ref_name == 'develop' && 'dev' || github.ref_name == 'main' && 'production' || 'staging' }}

    env:
      ARM_USE_OIDC: "true"
      ARM_CLIENT_ID: ${{ secrets.AZURE_CLIENT_ID }}
      ARM_TENANT_ID: ${{ secrets.AZURE_TENANT_ID }}
      ARM_SUBSCRIPTION_ID: ${{ secrets.AZURE_SUBSCRIPTION_ID }}
      TF_IN_AUTOMATION: "true"

    steps:
      # 1. Download repository code
      - name: Checkout Repository
        uses: actions/checkout@v6

      # 2. Install Terraform
      - name: Setup Terraform
        uses: hashicorp/setup-terraform@v4
        with:
          terraform_version: "1.14.6"

      # 3. Select environment from branch
      - name: Set Deployment Environment
        shell: bash
        run: |
          if [[ "${GITHUB_REF_NAME}" == "develop" ]]; then
            echo "ENVIRONMENT=dev" >> "$GITHUB_ENV"
          elif [[ "${GITHUB_REF_NAME}" == "staging" ]]; then
            echo "ENVIRONMENT=staging" >> "$GITHUB_ENV"
          elif [[ "${GITHUB_REF_NAME}" == "main" ]]; then
            echo "ENVIRONMENT=production" >> "$GITHUB_ENV"
          else
            echo "Unsupported branch"
            exit 1
          fi

      # 4. Authenticate to Azure using GitHub OIDC
      - name: Azure Login
        uses: azure/login@v3
        with:
          client-id: ${{ secrets.AZURE_CLIENT_ID }}
          tenant-id: ${{ secrets.AZURE_TENANT_ID }}
          subscription-id: ${{ secrets.AZURE_SUBSCRIPTION_ID }}

      # 5. Check Terraform formatting
      - name: Terraform Format
        run: terraform fmt -check -recursive

      # 6. Initialize Terraform with environment-specific state
      - name: Terraform Init
        run: |
          terraform init -input=false -reconfigure \
            -backend-config="environments/${ENVIRONMENT}.backend.hcl"

      # 7. Validate Terraform configuration
      - name: Terraform Validate
        run: terraform validate -no-color

      # 8. Create an execution plan
      - name: Terraform Plan
        run: |
          terraform plan \
            -input=false \
            -var-file="environments/${ENVIRONMENT}.tfvars" \
            -out=tfplan

      # 9. Apply the exact plan created above
      - name: Terraform Apply
        run: terraform apply -input=false -auto-approve tfplan
